{
    "name": "@evir/shoot-mp",
    "private": true,
    "homepage": "https://github.com/electrovir/shoot-mp",
    "bugs": {
        "url": "https://github.com/electrovir/shoot-mp/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/shoot-mp.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "type": "module",
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build:backend": "npm run compile && tsx node_modules/@augment-vir/node/src/scripts/fix-src-imports.script.ts",
        "build:frontend": "npm run build --workspace @evir/frontend",
        "compile": "virmator compile",
        "dev": "concurrently --colors --kill-others-on-fail -c blue,green --names frontend,backend \"npm start --workspace @evir/frontend\" \"npm run dev --workspace @evir/backend\"",
        "format": "virmator format",
        "lint": "virmator lint fix",
        "start": "npm start --workspace @evir/backend",
        "test": "mono-vir for-each-async npm run test",
        "test:all": "npm run compile && concurrently --colors --kill-others-on-fail -c auto --names tests,spelling,format,deps,lint \"npm run test\" \"npm run test:spelling\" \"npm run test:format\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:deps": "virmator deps check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.26.0",
        "@stylistic/eslint-plugin": "^4.2.0",
        "@stylistic/eslint-plugin-ts": "^4.2.0",
        "@typescript-eslint/eslint-plugin": "^8.32.0",
        "cspell": "^9.0.1",
        "dependency-cruiser": "^16.10.2",
        "esbuild": "^0.25.4",
        "eslint": "^9.26.0",
        "eslint-config-prettier": "^10.1.3",
        "eslint-plugin-jsdoc": "^50.6.11",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.2.0",
        "eslint-plugin-prettier": "^5.4.0",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.2",
        "eslint-plugin-unicorn": "^59.0.1",
        "mono-vir": "^2.0.6",
        "npm-check-updates": "^18.0.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.3.2",
        "prettier-plugin-multiline-arrays": "^4.0.3",
        "prettier-plugin-organize-imports": "^4.1.0",
        "prettier-plugin-packagejson": "^2.5.11",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.4",
        "typescript-eslint": "^8.32.0",
        "virmator": "^13.15.1"
    },
    "engines": {
        "node": ">=22"
    }
}
